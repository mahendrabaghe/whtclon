NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/connectx?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
FRONTEND_ORIGINS=http://localhost:3000,https://YOUR-USER.github.io
INVITATION_TTL_HOURS=72
MAX_MESSAGE_LENGTH=4000

# Cloudinary (set all three values to enable file and profile-image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_SIZE_BYTES=26214400

# Optional TURN relay. TURN_SECRET is the shared secret for a coturn REST API
# or compatible provider that supports time-limited HMAC-SHA1 credentials.
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
